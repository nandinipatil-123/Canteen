modules = ["nodejs-20", "web", "postgresql-16"]
[agent]
expertMode = true
integrations = ["javascript_supabase:1.0.0", "firebase_barebones_javascript:1.0.0"]

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "ADMIN_USERNAME=admin ADMIN_PASSWORD_HASH='$2b$12$o0ewDKwl2hJ5ZUFEHoqrr.AWT3eUI.y/v7J3paeQ7iT1/ks6QEvF.' SESSION_SECRET=super-secret-session-key-for-production npm run server & npx serve -s dist -l 5000"]
build = ["npm", "run", "build"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Development Server"

[[workflows.workflow]]
name = "Development Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "ADMIN_USERNAME=admin ADMIN_PASSWORD_HASH='$2b$12$o0ewDKwl2hJ5ZUFEHoqrr.AWT3eUI.y/v7J3paeQ7iT1/ks6QEvF.' VITE_FIREBASE_PROJECT_ID=demo-project VITE_FIREBASE_API_KEY=demo-api-key VITE_FIREBASE_APP_ID=demo-app-id npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 3001
externalPort = 3001
exposeLocalhost = true

[[ports]]
localPort = 5000
externalPort = 80
