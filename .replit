modules = ["nodejs-20", "web"]
[agent]
expertMode = true
integrations = ["javascript_supabase:1.0.0", "firebase_barebones_javascript:1.0.0"]

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "vm"
run = ["npm", "start"]
build = ["npm", "run", "build"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Development Server"

[[workflows.workflow]]
name = "Development Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "ADMIN_USERNAME=admin ADMIN_PASSWORD_HASH='$2b$12$YVZ7.67OZeymrMIKBnHSkO/9FEw1liYnJZDo7vHBFhid1ri6Hjtqa' VITE_FIREBASE_PROJECT_ID=demo-project VITE_FIREBASE_API_KEY=demo-api-key VITE_FIREBASE_APP_ID=demo-app-id npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 3001
externalPort = 3001
exposeLocalhost = true

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 33049
externalPort = 3000
