# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/dbname"

# Admin Authentication (Required)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="$2b$12$..." # Generate using: npm run generate-admin-hash

# Session Security (Required)
SESSION_SECRET="your-secure-random-secret-key-here"

# Production Configuration
NODE_ENV="production" # or "development"
FRONTEND_URL="https://your-domain.com" # Required in production
REDIS_URL="redis://localhost:6379" # Required for production session store

# Optional
PORT="3001"
HOST="0.0.0.0"

# Development Setup Instructions:
# 1. Copy this file to .env.local
# 2. Generate admin password hash: npm run generate-admin-hash
# 3. Generate random SESSION_SECRET: openssl rand -base64 32
# 4. Update ADMIN_PASSWORD_HASH and SESSION_SECRET with real values
# 5. Add your DATABASE_URL from Supabase